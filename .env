# Local development defaults only - NOT production secrets.
# Change these before exposing the stack anywhere beyond your machine.

# Host ports for the FastAPI services (each container listens on 8000 internally)
USER_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003

# Monitoring stack host ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
